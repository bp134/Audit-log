# =============================================================================
# Pharmacy Workflow & Compliance Automation - Environment Configuration
# =============================================================================

# 1. Azure Database for PostgreSQL - Flexible Server (TLS enforced)
DATABASE_URL=postgresql://app_compliance_writer:REPLACE_WITH_PASSWORD@your-server.postgres.database.azure.com:5432/pharmacy_compliance?sslmode=require
SQLITE_FALLBACK_PATH=/app/data/pharmacy_compliance.db

# 2. Slack App (Free Tier - Socket Mode)
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_APP_TOKEN=xapp-your-socket-mode-token
SLACK_CHANNEL_ID=C0123456789

# 3. Tranche Schedule (Europe/London)
PHARMACY_TIMEZONE=Europe/London
TRANCHE_MORNING_TIME=09:00
TRANCHE_MIDDAY_TIME=13:00
TRANCHE_EOD_TIME=17:30
TRANCHE_CLOSING_ESCALATION_TIME=18:15

# 4. Microsoft Entra ID (Single Sign-On & RBAC Governance)
ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000
ENTRA_CLIENT_ID=00000000-0000-0000-0000-000000000000
ENTRA_CLIENT_SECRET=replace-with-entra-client-secret
ENTRA_REDIRECT_URI=https://compliance.yourpharmacy.co.uk

# 5. Hetzner S3 Object Storage & Client-Side Encryption Key (64-char hex)
HETZNER_S3_ENDPOINT=https://fsn1.your-objectstorage.com
HETZNER_S3_BUCKET=pharmacy-compliance-vault
HETZNER_S3_ACCESS_KEY=replace-with-hetzner-access-key
HETZNER_S3_SECRET_KEY=replace-with-hetzner-secret-key
BACKUP_ENCRYPTION_KEY=replace_with_64_char_hex_master_encryption_key
